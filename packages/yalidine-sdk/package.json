{
    "name": "yalidine-sdk",
    "version": "0.1.0",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup index.js --format esm,cjs --dts",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "coverage": "vitest run --coverage"
    },
    "keywords": [
        "sdk",
        "yalidine",
        "shipping",
        "api"
    ],
    "devDependencies": {
        "@vitest/coverage-v8": "^4.0.14",
        "tsup": "^8.5.1",
        "vitest": "^4.0.14"
    }
}
