{
    "name": "yalidine-sdk",
    "version": "0.1.1",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "types": "./dist/index.d.ts",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup index.js --format esm,cjs --dts",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "coverage": "vitest run --coverage"
    },
    "keywords": [
        "sdk",
        "yalidine",
        "shipping",
        "api"
    ],
    "devDependencies": {
        "@vitest/coverage-v8": "^4.0.14",
        "tsup": "^8.5.1",
        "vitest": "^4.0.14"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Darknab/yalidine-sdk.git",
        "directory": "packages/yalidine-sdk"
    },
    "homepage": "https://github.com/Darknab/yalidine-sdk",
    "bugs": {
        "url": "https://github.com/Darknab/yalidine-sdk/issues"
    }
}
